BOT_TOKEN=TELEGRAM_BOTFATHER_TOKEN

# для запуска через Docker замените host на db (или другое название сервиса в случае изменения docker-compose)
DB_PATH=postgresql+asyncpg://user:password@host/dbname
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=dbname

# Интервал отправки отчёта портфеля в секундах
NOTIFY_INTERVAL_SECS=1800

# Rate Limiting
# Время, через которое лимит запросов сбрасывается
TIME_FOR_UPDATE_LIMIT_IN_SECS=60
# Количество запросов, которое можно выполнить за лимит (TIME_FOR_UPDATE_LIMIT_IN_SECS)
REQUEST_PER_LIMIT=5

# Путь для redis
REDIS_PATH=redis://:password@redis:6379/0
# Пароль для redis
REDIS_PASSWORD=password

# Порт для окошка (через которое он будет забирать наши метрики)
PROMETHEUS_DOOR_PORT=8000

# Port Grafana
GRAFANA_PORT=3000

# Логин и пароль для входа в интерфейс Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin